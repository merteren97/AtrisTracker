{
  "name": "atris-tracker",
  "version": "1.0.2",
  "description": "AtrisTracker - Professional Frameless Desktop Overlay to track AI CLI usage (Antigravity CLI, Codex CLI, Claude Code)",
  "main": "electron/main.js",
  "author": "merteren97",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/merteren97/AtrisTracker.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:backend": "node scripts/backend-smoke-test.js && node scripts/provider-probes-smoke-test.js && node --experimental-default-type=module scripts/quota-window-smoke-test.js",
    "prepare:linux-icons": "bash scripts/prepare-linux-icons.sh",
    "prepare:windows-icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-windows-icon.ps1",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:start": "electron .",
    "electron:build": "vite build && electron-builder",
    "electron:build:win": "npm run prepare:windows-icon && vite build && electron-builder --win nsis"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.7",
    "extract-zip": "^2.0.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.atristracker.app",
    "productName": "AtrisTracker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "merteren97",
        "repo": "AtrisTracker"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/windows-icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "Development",
      "maintainer": "merteren97 <37554755+merteren97@users.noreply.github.com>"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AtrisTracker",
      "runAfterFinish": true,
      "packElevateHelper": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
